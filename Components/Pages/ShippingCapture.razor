@page "/shipping-capture"

@using ReportPackaging.Services
@using ReportPackaging.Data.Sew.DTO
@using ReportPackaging.Data.Sew.IService
@using ReportPackaging.Data.Sew.Service
@using System.Text.Json
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Popups

@inject IBlobStorageService BlobStorageService
@inject ISew_FabricInboundScanService FabricInboundScanService
@inject IFactoryService FactoryService
@inject ISewGetDataFromUserService SewGetDataFromUserService

<div style="padding: 20px; font-family: sans-serif; max-width: 100%;">

    <h3>📦 Envío de Mercaderías</h3>

    @if (templateSeleccionado == 0)
    {
        <div style="margin-bottom:16px;">
            <p style="font-size:14px; color:#555; margin-bottom:12px;">
                Selecciona el tipo de documento a escanear:
            </p>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <button @onclick="() => SeleccionarTemplate(1)"
                        style="background:white; border:2px solid #0078d4; border-radius:10px; padding:14px 16px; text-align:left; cursor:pointer;">
                    <div style="font-weight:700; color:#0078d4; font-size:14px;">📄 Textiles Solafe</div>
                    <div style="font-size:12px; color:#777; margin-top:3px;">ENVIO DE MERCADERÍAS</div>
                </button>
                <button @onclick="() => SeleccionarTemplate(2)"
                        style="background:white; border:2px solid #107c41; border-radius:10px; padding:14px 16px; text-align:left; cursor:pointer;">
                    <div style="font-weight:700; color:#107c41; font-size:14px;">📄 C.R. Textil</div>
                    <div style="font-size:12px; color:#777; margin-top:3px;">ENVIO DE MERCADERÍAS — C.R. Textil, S.A.</div>
                </button>
                <button @onclick="() => SeleccionarTemplate(3)"
                        style="background:white; border:2px solid #e53935; border-radius:10px; padding:14px 16px; text-align:left; cursor:pointer;">
                    <div style="font-weight:700; color:#e53935; font-size:14px;">📄 Apparel Links</div>
                    <div style="font-size:12px; color:#777; margin-top:3px;">REPORTE DE PACKING LIST BODEGA DE TELA</div>
                </button>
            </div>
        </div>
    }
    else
    {
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;
                    padding:10px 14px; background:#f0f7ff; border-radius:8px; border:1px solid #0078d4;">
            <span style="font-size:13px; color:#0078d4; font-weight:600;">📄 @NombreTemplate</span>
            <SfButton CssClass="e-outline e-small" style="margin-left:auto;" OnClick="CambiarTemplate">Cambiar</SfButton>
        </div>

        <!-- FIX #2: botones nativos para que el ícono aparezca correctamente -->
        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
            <button @onclick="OnTakePhotoClicked" disabled="@isLoading"
                    style="background:#0078d4; color:white; padding:10px 18px; border:none; border-radius:6px;
                           font-size:14px; cursor:pointer; display:flex; align-items:center; gap:6px;">
                <span class="e-icons e-camera" style="font-size:16px;"></span> Tomar Foto
            </button>
            <button @onclick="OnPickPhotoClicked" disabled="@isLoading"
                    style="background:#107c41; color:white; padding:10px 18px; border:none; border-radius:6px;
                           font-size:14px; cursor:pointer; display:flex; align-items:center; gap:6px;">
                <span class="e-icons e-image" style="font-size:16px;"></span> Subir Imagen
            </button>
        </div>

        <!-- FIX #1: Vista previa con botón toggle -->
        @if (!string.IsNullOrEmpty(capturedImageBase64))
        {
            <div style="margin-bottom:16px;">
                <button @onclick="() => mostrarPreview = !mostrarPreview"
                        style="background:#f0f7ff; border:1px solid #0078d4; border-radius:6px;
                               padding:7px 14px; font-size:13px; color:#0078d4; cursor:pointer;
                               display:flex; align-items:center; gap:6px;">
                    <span class="e-icons @(mostrarPreview ? "e-chevron-up" : "e-chevron-down")" style="font-size:13px;"></span>
                    @(mostrarPreview ? "Ocultar vista previa" : "📷 Vista previa del documento")
                </button>
                @if (mostrarPreview)
                {
                    <div style="margin-top:10px; text-align:center;">
                        <img src="data:@(capturedImageContentType);base64,@capturedImageBase64"
                             alt="Documento capturado"
                             style="max-width:100%; max-height:300px; border-radius:8px; border:2px solid #0078d4;" />
                    </div>
                }
            </div>
        }

        @if (isLoading)
        {
            <div style="padding:16px; background:#fff8e1; border-radius:8px; color:#7a5c00; margin-bottom:16px;">
                ⏳ Procesando documento con Azure...
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding:12px; background:#fde8e8; border:1px solid #f44336; border-radius:8px; color:#c00; margin-bottom:16px;">
                ❌ @errorMessage
            </div>
        }

        @if (shippingData != null)
        {
            <div class="card card-bordered border-light mt-2 mb-2 p-0">
                <div class="card-header p-3" style="background-color:#f0f7ff;">
                    <h6 style="margin:0; color:#0078d4;">📋 General Information</h6>
                </div>
                <div class="card-body p-3">
                    <div class="flex-container">
                        <SfTextBox Placeholder="No. Envío" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="noEnvio" />
                        <div>
                            <label style="font-size:11px; color:#666; display:block; margin-bottom:4px;">Entry Date (Día / Mes / Año)</label>
                            <div style="display:flex; gap:4px;">
                                <SfTextBox Placeholder="DD" CssClass="e-outline" @bind-Value="shippingData.Dia" Width="55px" />
                                <SfTextBox Placeholder="MM" CssClass="e-outline" @bind-Value="shippingData.Mes" Width="55px" />
                                <SfTextBox Placeholder="AAAA" CssClass="e-outline" @bind-Value="shippingData.Ano" Width="75px" />
                            </div>
                        </div>
                        <SfDropDownList DataSource="@buyers" TItem="BuyerDTO" TValue="int"
                                        Placeholder="Buyer" AllowFiltering="true"
                                        FloatLabelType="FloatLabelType.Always" CssClass="e-outline"
                                        @bind-Value="selectedBuyerId">
                            <DropDownListFieldSettings Text="SmallName" Value="Id"></DropDownListFieldSettings>
                        </SfDropDownList>
                        <SfTextBox Placeholder="S/#" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.Serie" />
                        <SfDropDownList DataSource="@suppliers" TItem="SupplierDTO" TValue="int"
                                        Placeholder="Textile Company" AllowFiltering="true"
                                        FloatLabelType="FloatLabelType.Always" CssClass="e-outline"
                                        @bind-Value="selectedSupplierId">
                            <DropDownListFieldSettings Text="SupplierName" Value="Id"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                </div>
            </div>

            <div class="card card-bordered border-light mt-2 mb-2 p-0">
                <div class="card-header p-3" style="background-color:#e8f4fd;">
                    <h6 style="margin:0; color:#0078d4;">🧵 Fabric Information</h6>
                </div>
                <div class="card-body p-3">
                    <div class="flex-container">
                        <SfTextBox Placeholder="Tipo de Tela" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.TipoDeTela" />
                        <SfTextBox Placeholder="Color" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.Color" />
                        <SfTextBox Placeholder="Lot" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.Lot" />
                        <SfTextBox Placeholder="Width" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.Ancho" />
                        <SfNumericTextBox Placeholder="Rolls" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" ShowSpinButton="false" @bind-Value="shippingData.TotalRolls" />
                        <SfNumericTextBox Placeholder="Peso (Kgs)" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" ShowSpinButton="false" @bind-Value="shippingData.TotalPesoCrudo" />
                        <SfTextBox Placeholder="Rack" FloatLabelType="FloatLabelType.Always" CssClass="e-outline" @bind-Value="shippingData.Rack" />
                    </div>

                    <!-- Body / Rib toggle -->
                    <div style="margin-top:16px;">
                        <label style="font-size:11px; color:#666; display:block; margin-bottom:6px;">Yards — selecciona tipo</label>
                        <div style="display:flex; gap:0; margin-bottom:8px;">
                            <button @onclick="() => SeleccionarTipoYards(true)"
                                    style="flex:1; padding:8px; border:2px solid @(isBody ? "#0078d4" : "#ccc");
                                           background:@(isBody ? "#0078d4" : "white"); color:@(isBody ? "white" : "#333");
                                           border-radius:6px 0 0 6px; cursor:pointer; font-weight:600; font-size:13px;">
                                🧴 Body
                            </button>
                            <button @onclick="() => SeleccionarTipoYards(false)"
                                    style="flex:1; padding:8px; border:2px solid @(!isBody ? "#0078d4" : "#ccc");
                                           background:@(!isBody ? "#0078d4" : "white"); color:@(!isBody ? "white" : "#333");
                                           border-radius:0 6px 6px 0; cursor:pointer; font-weight:600; font-size:13px;">
                                🧶 Rib
                            </button>
                        </div>
                        <!-- FIX #3: Enabled="true" para permitir edición -->
                        <div style="display:flex; align-items:center; gap:8px;">
                            <SfNumericTextBox @bind-Value="shippingData.TotalYards"
                                              Enabled="true"
                                              CssClass="e-outline"
                                              ShowSpinButton="false"
                                              Placeholder="Total Yards"
                                              FloatLabelType="FloatLabelType.Always"
                                              Width="160px" />
                            <span style="font-size:11px; color:#888;">→ @(isBody ? "Body Received" : "Rib Received")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
                <SfButton CssClass="e-success e-large" IconCss="e-icons e-save" OnClick="GuardarDatos" Disabled="@isGuardando">
                    @(isGuardando ? "Guardando..." : "Guardar en DB")
                </SfButton>
            </div>

            @if (!string.IsNullOrEmpty(mensajeGuardado))
            {
                <div style="margin-top:12px; padding:12px; background:#e8f5e9; border-radius:8px; color:#2e7d32;">
                    ✅ @mensajeGuardado
                </div>
            }
        }
    }

</div>

<style>
    .flex-container { display:flex; flex-wrap:wrap; gap:14px; }
    .flex-container > * { flex:1; min-width:160px; }
</style>

@code {

    private int    templateSeleccionado = 0;
    private bool   isLoading            = false;
    private bool   isGuardando          = false;
    private bool   isBody               = true;
    private bool   mostrarPreview       = false;
    private string errorMessage         = string.Empty;
    private string mensajeGuardado      = string.Empty;
    private string noEnvio              = string.Empty;
    private ShippingData? shippingData  = null;

    private string? imageUrl                  = null;
    private MemoryStream? capturedImageStream = null;
    private string? capturedImageContentType  = null;
    private string? capturedImageFileName     = null;
    private string? capturedImageBase64       = null;

    private int selectedBuyerId    = 0;
    private int selectedSupplierId = 0;
    private string _email          = string.Empty;
    private bool   _isLoggedIn;

    private List<BuyerDTO>    buyers    = new();
    private List<SupplierDTO> suppliers = new();
    private Sew_GetDataFromUserDTO? currentUser = null;

    private string NombreTemplate => templateSeleccionado switch
    {
        1 => "Textiles Solafe — ENVIO DE MERCADERÍAS",
        2 => "C.R. Textil — ENVIO DE MERCADERÍAS",
        3 => "Apparel Links — PACKING LIST BODEGA DE TELA",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync() => await CargarListas();

    // private async Task CargarListas()
    // {
    //     // currentUser = (await SewGetDataFromUserService.GetAllAsync(_email)).FirstOrDefault();
    //     // Console.WriteLine($"Id:{currentUser.ID} | UserName:{currentUser.UserName} | Email:{currentUser.Email} | NameEn:{currentUser.NameEn} | CenterId:{currentUser.CenterId}");
    //     buyers    = (await FactoryService.GetBuyersByCenter(14)).ToList();
    //     suppliers = (await FactoryService.GetSuppliersByCenter(14)).ToList();
    // }

    private async Task CargarListas()
    {
        currentUser = (await SewGetDataFromUserService.GetAllAsync(_email)).FirstOrDefault();
        Console.WriteLine($"Id:{currentUser.ID} | UserName:{currentUser.UserName} | Email:{currentUser.Email} | NameEn:{currentUser.NameEn} | CenterId:{currentUser.CenterId}");

        buyers = (await FactoryService.GetBuyersByCenter(currentUser.CenterId)).ToList();
        suppliers = (await FactoryService.GetSuppliersByCenter(currentUser.CenterId)).ToList();
    }


    private void SeleccionarTemplate(int template)
    {
        templateSeleccionado = template;
        shippingData    = null;
        errorMessage    = string.Empty;
        mensajeGuardado = string.Empty;
        mostrarPreview  = false;
        StateHasChanged();
    }

    private void CambiarTemplate()
    {
        templateSeleccionado = 0;
        shippingData   = null;
        errorMessage   = string.Empty;
        mostrarPreview = false;
        StateHasChanged();
    }

    private void SeleccionarTipoYards(bool body) { isBody = body; StateHasChanged(); }

    private void AutoSeleccionarListas()
    {
        if (!string.IsNullOrWhiteSpace(shippingData?.Buyer))
        {
            var match = buyers.FirstOrDefault(b =>
                b.BuyerName.Contains(shippingData.Buyer, StringComparison.OrdinalIgnoreCase) ||
                b.SmallName?.Contains(shippingData.Buyer, StringComparison.OrdinalIgnoreCase) == true ||
                shippingData.Buyer.Contains(b.BuyerName, StringComparison.OrdinalIgnoreCase));
            selectedBuyerId = match?.Id ?? 0;
        }
        if (!string.IsNullOrWhiteSpace(shippingData?.TextileCompany))
        {
            var match = suppliers.FirstOrDefault(s =>
                s.SupplierName.Contains(shippingData.TextileCompany, StringComparison.OrdinalIgnoreCase) ||
                shippingData.TextileCompany.Contains(s.SupplierName, StringComparison.OrdinalIgnoreCase));
            selectedSupplierId = match?.Id ?? 0;
        }
    }

    private async Task OnTakePhotoClicked()
    {
        if (!MediaPicker.Default.IsCaptureSupported) { errorMessage = "Este dispositivo no soporta cámara."; return; }
        var photo = await MediaPicker.Default.CapturePhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task OnPickPhotoClicked()
    {
        var photo = await MediaPicker.Default.PickPhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task ProcesarFoto(FileResult photo)
    {
        try
        {
            errorMessage = string.Empty; mensajeGuardado = string.Empty;
            shippingData = null; isBody = true; selectedBuyerId = 0; selectedSupplierId = 0;
            imageUrl = null; capturedImageBase64 = null; mostrarPreview = false;
            isLoading = true; StateHasChanged();

            AppSettingsLoader.Load();
            var endpoint = AppSettings.Current.AzureComputerVision.Endpoint;
            var apiKey   = AppSettings.Current.AzureComputerVision.Key;

            if (string.IsNullOrWhiteSpace(endpoint) || string.IsNullOrWhiteSpace(apiKey))
            { errorMessage = "No se encontró el Endpoint o Key de Azure en appsettings.json."; return; }

            using var stream = await photo.OpenReadAsync();
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            capturedImageStream?.Dispose();
            capturedImageStream = new MemoryStream();
            await memoryStream.CopyToAsync(capturedImageStream);
            capturedImageStream.Position = 0;
            memoryStream.Position = 0;

            capturedImageContentType = photo.ContentType ?? "image/jpeg";
            capturedImageFileName    = photo.FileName;
            capturedImageBase64      = Convert.ToBase64String(capturedImageStream.ToArray());

            shippingData = templateSeleccionado switch
            {
                1 => await new AzureShippingService(endpoint, apiKey).AnalyzeShippingAsync(memoryStream),
                2 => await new AzureShippingServiceCR(endpoint, apiKey).AnalyzeShippingAsync(memoryStream),
                3 => await new AzureShippingServiceAL(endpoint, apiKey).AnalyzeShippingAsync(memoryStream),
                _ => throw new Exception("Template no seleccionado.")
            };
            AutoSeleccionarListas();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"[ShippingCapture] {ex}");
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task GuardarDatos()
    {
        try
        {
            isGuardando = true; mensajeGuardado = string.Empty; StateHasChanged();

            if (capturedImageStream != null && capturedImageStream.Length > 0)
            {
                capturedImageStream.Position = 0;
                var cleanName  = (capturedImageFileName ?? $"scan_{DateTime.Now:yyyyMMddHHmmss}.jpg").Replace(" ", "");
                var uniqueName = $"{DateTime.Now:yyyyMMddHHmmss}_{cleanName}";
                imageUrl = await BlobStorageService.UploadFileToBlobAsync(
                    $"Sew/FabricInboundScans/{uniqueName}",
                    capturedImageContentType ?? "image/jpeg",
                    capturedImageStream);
                System.Diagnostics.Debug.WriteLine($"[ShippingCapture] Imagen subida: {imageUrl}");
            }

            DateTime entryDate = DateTime.Now;
            if (int.TryParse(shippingData.Dia, out int dia) &&
                int.TryParse(shippingData.Mes, out int mes) &&
                int.TryParse(shippingData.Ano, out int ano))
                entryDate = new DateTime(ano, mes, dia);

            decimal bodyReceived = isBody ? shippingData.TotalYards : 0;
            decimal ribReceived  = isBody ? 0 : shippingData.TotalYards;
            var supplierName     = suppliers.FirstOrDefault(s => s.Id == selectedSupplierId)?.SupplierName ?? string.Empty;

            var dto = new Sew_FabricInboundScanDTO
            {
                EnvID                   = noEnvio,
                EntryDate               = entryDate,
                FileNo                  = shippingData.Serie      ?? string.Empty,
                Color                   = shippingData.Color      ?? string.Empty,
                Lot                     = shippingData.Lot        ?? string.Empty,
                Width                   = shippingData.Ancho      ?? string.Empty,
                Rolls                   = shippingData.TotalRolls,
                KgsReceived             = shippingData.TotalPesoCrudo,
                BodyReceived            = bodyReceived,
                RibReceived             = ribReceived,
                FabricType              = shippingData.TipoDeTela ?? string.Empty,
                SupplierName            = supplierName,
                SupplierId              = selectedSupplierId,
                BuyerId                 = selectedBuyerId,
                Rack                    = shippingData.Rack       ?? string.Empty,
                ImageUrl                = imageUrl                ?? string.Empty,
                CreatedDate             = DateTime.Now,
                LastUpdatedDate         = DateTime.Now,
                CreatedByUserName       = currentUser.UserName,
                LastUpdatedByUserId     = currentUser.ID,
                LastUpdatedByUserNameEn = currentUser.NameEn,
                CenterId                = currentUser.CenterId
            };

            var ok = await FabricInboundScanService.CreateFabricInboundScan(dto);
            mensajeGuardado = ok ? "Documento guardado correctamente." : "⚠️ Error al guardar. Revisa tu conexión.";
        }
        catch (Exception ex) { errorMessage = $"Error al guardar: {ex.Message}"; }
        finally { isGuardando = false; StateHasChanged(); }
    }
}
