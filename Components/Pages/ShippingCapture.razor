@page "/shipping-capture"

@using ReportPackaging.Services
@using System.Text.Json

<div style="padding: 20px; font-family: sans-serif; max-width: 100%;">

    <h3>📦 Envío de Mercaderías</h3>

    <!-- Botones de captura -->
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
        <button @onclick="OnTakePhotoClicked" disabled="@isLoading"
                style="background:#0078d4; color:white; padding:12px 20px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
            📷 Tomar Foto
        </button>
        <button @onclick="OnPickPhotoClicked" disabled="@isLoading"
                style="background:#107c41; color:white; padding:12px 20px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
            🖼️ Subir Imagen
        </button>
    </div>

    <!-- Loading -->
    @if (isLoading)
    {
        <div style="padding:16px; background:#fff8e1; border-radius:8px; color:#7a5c00; margin-bottom:16px;">
            ⏳ Procesando documento con Azure...
        </div>
    }

    <!-- Error -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding:12px; background:#fde8e8; border:1px solid #f44336; border-radius:8px; color:#c00; margin-bottom:16px;">
            ❌ @errorMessage
        </div>
    }

    <!-- Datos extraídos -->
    @if (shippingData != null)
    {
        <!-- Encabezado editable -->
        <div style="background:#f5f5f5; border-radius:8px; padding:16px; margin-bottom:16px;">
            <h4 style="margin-top:0;">📋 Encabezado</h4>
            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:10px;">

                <div>
                    <label style="@labelStyle">Fecha (Día / Mes / Año)</label>
                    <div style="display:flex; gap:4px;">
                        <input style="@inputStyle; width:50px;" @bind="shippingData.Dia" placeholder="DD" />
                        <input style="@inputStyle; width:50px;" @bind="shippingData.Mes" placeholder="MM" />
                        <input style="@inputStyle; width:60px;" @bind="shippingData.Ano" placeholder="AAAA" />
                    </div>
                </div>

                <div>
                    <label style="@labelStyle">No.</label>
                    <input style="@inputStyle" @bind="shippingData.No" />
                </div>

                <div>
                    <label style="@labelStyle">Cliente</label>
                    <input style="@inputStyle" @bind="shippingData.Cliente" />
                </div>

                <div>
                    <label style="@labelStyle">Buyer</label>
                    <input style="@inputStyle" @bind="shippingData.Buyer" />
                </div>

                <div>
                    <label style="@labelStyle">Fábrica de Llegada</label>
                    <input style="@inputStyle" @bind="shippingData.FabricaDeLlegada" />
                </div>

                <div>
                    <label style="@labelStyle">S/#</label>
                    <input style="@inputStyle" @bind="shippingData.Serie" />
                </div>

                <div>
                    <label style="@labelStyle">Tipo de Tela</label>
                    <input style="@inputStyle" @bind="shippingData.TipoDeTela" />
                </div>

                <div>
                    <label style="@labelStyle">Ancho</label>
                    <input style="@inputStyle" @bind="shippingData.Ancho" />
                </div>

                <div>
                    <label style="@labelStyle">Color</label>
                    <input style="@inputStyle" @bind="shippingData.Color" />
                </div>

                <div>
                    <label style="@labelStyle">Lot</label>
                    <input style="@inputStyle" @bind="shippingData.Lot" />
                </div>

            </div>
        </div>

        <!-- Tabla de Rolls editable -->
        <h4>🧵 Rolls — @shippingData.Rolls.Count fila(s) detectadas</h4>
        <div style="overflow-x:auto; border:1px solid #ddd; border-radius:8px; margin-bottom:16px;">
            <table style="border-collapse:collapse; width:100%; font-size:13px;">
                <thead>
                    <tr style="background:#0078d4; color:white;">
                        <th style="@thStyle">#</th>
                        <th style="@thStyle">No. de Roll</th>
                        <th style="@thStyle">Peso de Crudo</th>
                        <th style="@thStyle">Peso de Acabado</th>
                        <th style="@thStyle">Yards</th>
                        <th style="@thStyle">🗑️</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var roll in shippingData.Rolls)
                    {
                        var r = roll;
                        <tr style="border-bottom:1px solid #eee;">
                            <td style="@tdStyle"><input style="@inputStyleNum" @bind="r.Numero" /></td>
                            <td style="@tdStyle"><input style="@inputStyleNum" @bind="r.NumeroDeRoll" /></td>
                            <td style="@tdStyle"><input style="@inputStyleNum" @bind="r.PesoDeCrudo" /></td>
                            <td style="@tdStyle"><input style="@inputStyleNum" @bind="r.PesoDeAcabado" /></td>
                            <td style="@tdStyle"><input style="@inputStyleNum" @bind="r.Yards" /></td>
                            <td style="@tdStyle; text-align:center;">
                                <button @onclick="() => EliminarRoll(r)"
                                        style="background:none; border:none; color:#e53935; font-size:16px; cursor:pointer;">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pie de documento -->
        <div style="background:#f5f5f5; border-radius:8px; padding:16px; margin-bottom:16px;">
            <h4 style="margin-top:0;">📊 Totales</h4>
            <div style="display:flex; gap:16px; flex-wrap:wrap;">
                <div>
                    <label style="@labelStyle">Grand Total</label>
                    <input style="@inputStyle" @bind="shippingData.GrandTotal" />
                </div>
                <div>
                    <label style="@labelStyle">Número de Orden</label>
                    <input style="@inputStyle" @bind="shippingData.OrderNumber" />
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button @onclick="AgregarRoll"
                    style="background:#6c757d; color:white; padding:10px 18px; border:none; border-radius:8px; cursor:pointer;">
                ➕ Agregar Fila
            </button>
            <button @onclick="GuardarDatos" disabled="@isGuardando"
                    style="background:#28a745; color:white; padding:10px 24px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
                💾 @(isGuardando ? "Guardando..." : "Guardar en DB")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(mensajeGuardado))
        {
            <div style="margin-top:12px; padding:12px; background:#e8f5e9; border-radius:8px; color:#2e7d32;">
                ✅ @mensajeGuardado
            </div>
        }
    }

</div>

@code {

    private bool isLoading = false;
    private bool isGuardando = false;
    private string errorMessage = string.Empty;
    private string mensajeGuardado = string.Empty;
    private ShippingData? shippingData = null;

    // Estilos
    private string thStyle = "padding:8px 10px; text-align:left; white-space:nowrap;";
    private string tdStyle = "padding:4px 6px;";
    private string inputStyle = "width:100%; padding:6px; border:1px solid #ccc; border-radius:4px; font-size:13px; box-sizing:border-box;";
    private string inputStyleNum = "width:80px; padding:4px; border:1px solid #ccc; border-radius:4px; font-size:12px; text-align:right;";
    private string labelStyle = "font-size:11px; color:#666; display:block; margin-bottom:3px;";

    private async Task OnTakePhotoClicked()
    {
        if (!MediaPicker.Default.IsCaptureSupported)
        {
            errorMessage = "Este dispositivo no soporta cámara.";
            return;
        }
        var photo = await MediaPicker.Default.CapturePhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task OnPickPhotoClicked()
    {
        var photo = await MediaPicker.Default.PickPhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task ProcesarFoto(FileResult photo)
    {
        try
        {
            errorMessage = string.Empty;
            mensajeGuardado = string.Empty;
            shippingData = null;
            isLoading = true;
            StateHasChanged();

            AppSettingsLoader.Load();
            var endpoint = AppSettings.Current.AzureComputerVision.Endpoint;
            var apiKey = AppSettings.Current.AzureComputerVision.Key;

            if (string.IsNullOrWhiteSpace(endpoint) || string.IsNullOrWhiteSpace(apiKey))
            {
                errorMessage = "No se encontró el Endpoint o Key de Azure en appsettings.json.";
                return;
            }

            using var stream = await photo.OpenReadAsync();
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var service = new AzureShippingService(endpoint, apiKey);
            shippingData = await service.AnalyzeShippingAsync(memoryStream);

            if (shippingData.Rolls.Count == 0)
                errorMessage = "No se detectaron rolls. Intenta con mejor iluminación.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"[ShippingCapture] {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EliminarRoll(ShippingRollRow roll)
    {
        shippingData?.Rolls.Remove(roll);
    }

    private void AgregarRoll()
    {
        shippingData?.Rolls.Add(new ShippingRollRow());
    }

    private async Task GuardarDatos()
    {
        try
        {
            isGuardando = true;
            mensajeGuardado = string.Empty;
            StateHasChanged();

            // TODO: conectar DB
            await Task.Delay(800);
            // await _dbService.GuardarEnvio(shippingData);

            mensajeGuardado = $"Documento guardado — {shippingData?.Rolls.Count} roll(s).";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            isGuardando = false;
            StateHasChanged();
        }
    }
}
