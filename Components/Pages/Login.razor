@page "/"
@using ReportPackaging.Config
@using ReportPackaging.Helpers
@using ReportPackaging.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@inject NavigationManager Navigation

@if (_checking)
{
    <div style="display:flex; justify-content:center; align-items:center; height:100vh; background:#F3F4F6;">
        <p style="color:#6B7280;">Cargando...</p>
    </div>
}
else
{
    <div class="login-container">
        <div class="login-card">
            <h1 class="login-title">Auth Demo</h1>
            <p class="login-subtitle">Ingreso corporativo seguro</p>

            <button class="login-btn" @onclick="OnLoginClicked" disabled="@_isLoading">
                @(_isLoading ? "Autenticando..." : "Iniciar Sesión (Clerk OTP)")
            </button>

            <p class="login-status">@_statusMessage</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="login-error">@_errorMessage</p>
            }
        </div>
    </div>
}

<div class="login-container">
    <div class="login-card">

        <h1 class="login-title">Auth Demo</h1>
        <p class="login-subtitle">Ingreso corporativo seguro</p>

        <button class="login-btn" @onclick="OnLoginClicked" disabled="@_isLoading">
            @(_isLoading ? "Autenticando..." : "Iniciar Sesión (Clerk OTP)")
        </button>

        <p class="login-status">@_statusMessage</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="login-error">@_errorMessage</p>
        }

    </div>
</div>

@code {
    private readonly HttpClient _httpClient = new();

    private bool _isLoading = false;
    private string _statusMessage = "Esperando autenticación...";
    private string _errorMessage = string.Empty;
    private bool _checking = true;

    protected override void OnInitialized()
    {
        if (Preferences.Get("is_logged_in", false))
        {
            Navigation.NavigateTo("/home");
            return; // ← importante el return
        }
        _checking = false; // ← solo llega aquí si NO está loggeado
    }

    private async Task OnLoginClicked()
    {
        try
        {
            _isLoading = true;
            _errorMessage = string.Empty;
            _statusMessage = "Iniciando autenticación...";

            // 1. Generar PKCE
            string codeVerifier = PkceHelper.GenerateCodeVerifier();
            string codeChallenge = PkceHelper.GenerateCodeChallenge(codeVerifier);

            // 2. Construir URL de autorización hacia Clerk
            string authUrl = $"{AuthConfig.AuthorizeUrl}" +
                             $"?client_id={AuthConfig.ClientId}" +
                             $"&redirect_uri={AuthConfig.RedirectUri}" +
                             $"&response_type=code" +
                             $"&scope=openid email profile offline_access" +
                             $"&code_challenge={codeChallenge}" +
                             $"&code_challenge_method=S256";

            // 3. Abrir el navegador nativo (WebAuthenticator)
            var result = await WebAuthenticator.Default.AuthenticateAsync(
                new Uri(authUrl),
                new Uri(AuthConfig.RedirectUri));

            if (result?.Properties != null && result.Properties.ContainsKey("code"))
            {
                _statusMessage = "Intercambiando código...";

                // 4. Intercambiar código por TokenResponse completo
                var token = await ExchangeCodeForTokenAsync(result.Properties["code"], codeVerifier);

                System.Diagnostics.Debug.WriteLine($"[Login] AccessToken: {token?.AccessToken ?? "NULL"}");
                System.Diagnostics.Debug.WriteLine($"[Login] IdToken: {token?.IdToken ?? "NULL"}");

                if (token != null && !string.IsNullOrEmpty(token.AccessToken))
                {
                    // 5. Obtener email desde Clerk usando el AccessToken
                    string? email = await GetUserEmailFromClerk(token.AccessToken);

                    if (!string.IsNullOrEmpty(email))
                    {
                        // 6. Guardar sesión
                        await SessionService.SaveSessionAsync(token.AccessToken, email);
                        await SecureStorage.SetAsync("clerk_JWT", token.IdToken);

                        var verificacion = await SecureStorage.GetAsync("clerk_JWT");
                        System.Diagnostics.Debug.WriteLine($"[Login] clerk_JWT guardado: {verificacion ?? "NULL"}");
                        await SecureStorage.SetAsync("login_type", "clerk");

                        _statusMessage = "Autenticado correctamente ✅";
                        Navigation.NavigateTo("/home", forceLoad: true);
                    }
                    else
                    {
                        _errorMessage = "No se pudo recuperar el correo del usuario.";
                        _statusMessage = "Error en login.";
                    }
                }
                else
                {
                    _errorMessage = "No se pudo obtener el token. Intenta de nuevo.";
                    _statusMessage = "Error en login.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Login fallido: " + ex.Message;
            _statusMessage = "Error en login.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<TokenResponse?> ExchangeCodeForTokenAsync(string code, string codeVerifier)
    {
        var content = new FormUrlEncodedContent(new[]
        {
        new KeyValuePair<string, string>("grant_type",    "authorization_code"),
        new KeyValuePair<string, string>("client_id",     AuthConfig.ClientId),
        new KeyValuePair<string, string>("code",          code),
        new KeyValuePair<string, string>("redirect_uri",  AuthConfig.RedirectUri),
        new KeyValuePair<string, string>("code_verifier", codeVerifier)
    });

        var response = await _httpClient.PostAsync(AuthConfig.TokenUrl, content);
        var json = await response.Content.ReadAsStringAsync();

        System.Diagnostics.Debug.WriteLine($"[Login] Token JSON: {json}");

        if (!response.IsSuccessStatusCode) return null;
        return JsonSerializer.Deserialize<TokenResponse>(json);
    }

    private async Task<string?> GetUserEmailFromClerk(string accessToken)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, AuthConfig.UserInfoUrl);
        request.Headers.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", accessToken);

        var response = await _httpClient.SendAsync(request);
        if (!response.IsSuccessStatusCode) return null;

        var json = await response.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);

        return doc.RootElement.TryGetProperty("email", out var emailElement)
            ? emailElement.GetString()
            : null;
    }

    // ── Token Response Model ──────────────────────────────────────────────────
    public class TokenResponse
    {
        [JsonPropertyName("access_token")]
        public string AccessToken { get; set; } = string.Empty;

        [JsonPropertyName("id_token")]
        public string IdToken { get; set; } = string.Empty;

        [JsonPropertyName("token_type")]
        public string TokenType { get; set; } = string.Empty;
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #F3F4F6;
        padding: 30px;
    }

    .login-card {
        background: white;
        border-radius: 10px;
        padding: 40px 30px;
        width: 100%;
        max-width: 380px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .login-title {
        font-size: 2rem;
        font-weight: bold;
        color: #111827;
        margin: 0;
    }

    .login-subtitle {
        font-size: 1rem;
        color: #6B7280;
        margin: 0;
    }

    .login-btn {
        width: 100%;
        height: 50px;
        background-color: #4F46E5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 10px;
    }

        .login-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .login-status {
        font-size: 0.75rem;
        color: #9CA3AF;
        margin: 0;
    }

    .login-error {
        font-size: 0.85rem;
        color: #EF4444;
        margin: 0;
        text-align: center;
    }
</style>
