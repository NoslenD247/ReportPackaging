@page "/"
@using ReportPackaging.Config
@using ReportPackaging.Helpers
@using ReportPackaging.Services
@using System.Text.Json
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">

        <h1 class="login-title">Auth Demo</h1>
        <p class="login-subtitle">Ingreso corporativo seguro</p>

        <button class="login-btn" @onclick="OnLoginClicked" disabled="@_isLoading">
            @(_isLoading ? "Autenticando..." : "Iniciar Sesión (Clerk OTP)")
        </button>

        <p class="login-status">@_statusMessage</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="login-error">@_errorMessage</p>
        }

    </div>
</div>

@code {
    private readonly HttpClient _httpClient = new();

    private bool _isLoading = false;
    private string _statusMessage = "Esperando autenticación...";
    private string _errorMessage = string.Empty;

    private async Task OnLoginClicked()
    {
        try
        {
            _isLoading = true;
            _errorMessage = string.Empty;
            _statusMessage = "Iniciando autenticación...";

            // 1. Generar PKCE
            string codeVerifier = PkceHelper.GenerateCodeVerifier();
            string codeChallenge = PkceHelper.GenerateCodeChallenge(codeVerifier);

            // 2. Construir URL de autorización hacia Clerk
            string authUrl = $"{AuthConfig.AuthorizeUrl}" +
                             $"?client_id={AuthConfig.ClientId}" +
                             $"&redirect_uri={AuthConfig.RedirectUri}" +
                             $"&response_type=code" +
                             $"&scope=email profile offline_access" +
                             $"&code_challenge={codeChallenge}" +
                             $"&code_challenge_method=S256";

            // 3. Abrir el navegador nativo (WebAuthenticator)
            var result = await WebAuthenticator.Default.AuthenticateAsync(
                new Uri(authUrl),
                new Uri(AuthConfig.RedirectUri));

            if (result?.Properties != null && result.Properties.ContainsKey("code"))
            {
                _statusMessage = "Intercambiando código...";

                // 4. Intercambiar código por Token JWT
                string? token = await ExchangeCodeForTokenAsync(result.Properties["code"], codeVerifier);

                if (!string.IsNullOrEmpty(token))
                {
                    // 5. Obtener email desde Clerk
                    string? email = await GetUserEmailFromClerk(token);

                    if (!string.IsNullOrEmpty(email))
                    {
                        // 6. Guardar sesión de forma segura
                        await SessionService.SaveSessionAsync(token, email);
                        _statusMessage = "Autenticado correctamente ✅";
                        Navigation.NavigateTo("/");
                    }
                    else
                    {
                        _errorMessage = "No se pudo recuperar el correo del usuario.";
                        _statusMessage = "Error en login.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Login fallido: " + ex.Message;
            _statusMessage = "Error en login.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<string?> ExchangeCodeForTokenAsync(string code, string codeVerifier)
    {
        var content = new FormUrlEncodedContent(new[]
        {
            new KeyValuePair<string, string>("grant_type",    "authorization_code"),
            new KeyValuePair<string, string>("client_id",     AuthConfig.ClientId),
            new KeyValuePair<string, string>("code",          code),
            new KeyValuePair<string, string>("redirect_uri",  AuthConfig.RedirectUri),
            new KeyValuePair<string, string>("code_verifier", codeVerifier)
        });

        var response = await _httpClient.PostAsync(AuthConfig.TokenUrl, content);
        if (!response.IsSuccessStatusCode)
            return null;

        var json = await response.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);
        return doc.RootElement.GetProperty("access_token").GetString();
    }

    private async Task<string?> GetUserEmailFromClerk(string accessToken)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, AuthConfig.UserInfoUrl);
        request.Headers.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", accessToken);

        var response = await _httpClient.SendAsync(request);
        if (!response.IsSuccessStatusCode)
            return null;

        var json = await response.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);

        return doc.RootElement.TryGetProperty("email", out var emailElement)
            ? emailElement.GetString()
            : null;
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #F3F4F6;
        padding: 30px;
    }

    .login-card {
        background: white;
        border-radius: 10px;
        padding: 40px 30px;
        width: 100%;
        max-width: 380px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .login-title {
        font-size: 2rem;
        font-weight: bold;
        color: #111827;
        margin: 0;
    }

    .login-subtitle {
        font-size: 1rem;
        color: #6B7280;
        margin: 0;
    }

    .login-btn {
        width: 100%;
        height: 50px;
        background-color: #4F46E5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 10px;
    }

        .login-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .login-status {
        font-size: 0.75rem;
        color: #9CA3AF;
        margin: 0;
    }

    .login-error {
        font-size: 0.85rem;
        color: #EF4444;
        margin: 0;
        text-align: center;
    }
</style>
