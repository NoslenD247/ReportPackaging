@page "/take-photo"

@using ReportPackaging.Services
@using ReportPackaging.Data.Sew.IService
@using ReportPackaging.Data.Sew.Service
@using ReportPackaging.Data.Sew.DTO

@using System.Text.Json

@inject ITempPackingService TempPackingService;
<div style="font-family: sans-serif; max-width: 100%;">

    <h3>📷 Escanear Reporte</h3>

    <!-- Botones de captura -->
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:25px;">
        <button @onclick="OnTakePhotoClicked" disabled="@isLoading"
                style="background:#0078d4; color:white; padding:12px 20px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
            📷 Tomar Foto
        </button>
        <button @onclick="OnPickPhotoClicked" disabled="@isLoading"
                style="background:#107c41; color:white; padding:12px 20px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
            🖼️ Subir Imagen
        </button>
    </div>

    <!-- Loading -->
    @if (isLoading)
    {
        <div style="padding:16px; background:#fff8e1; border-radius:8px; color:#7a5c00; margin-bottom:16px;">
            ⏳ Procesando imagen, espera un momento...
        </div>
    }

    <!-- Error -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding:12px; background:#fde8e8; border:1px solid #f44336; border-radius:8px; color:#c00; margin-bottom:16px;">
            ❌ @errorMessage
        </div>
    }

    <!-- Tabla editable -->
    @if (rows.Count > 0)
    {
        <div style="margin-top:10px;">
            <h4>✅ @rows.Count fila(s) detectadas — edita si es necesario</h4>

            <div style="overflow-x:auto; border:1px solid #ddd; border-radius:8px;">
                <table style="border-collapse:collapse; width:100%; font-size:13px;">
                    <thead>
                        <tr style="background:#0078d4; color:white;">
                            <th style="@thStyle">Buyer</th>
                            <th style="@thStyle">Style</th>
                            <th style="@thStyle">PO#</th>
                            <th style="@thStyle">Color</th>
                            <th style="@thStyle">🗑️</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            var r = row;
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="@tdStyle"><input style="@inputStyle" @bind="r.Buyer" /></td>
                                <td style="@tdStyle"><input style="@inputStyle" @bind="r.Style" /></td>
                                <td style="@tdStyle"><input style="@inputStyle" @bind="r.PO" /></td>
                                <td style="@tdStyle"><input style="@inputStyle" @bind="r.Color" /></td>
                                <td style="@tdStyle; text-align:center;">
                                    <button @onclick="() => EliminarFila(r)"
                                            style="background:none; border:none; color:#e53935; font-size:16px; cursor:pointer;">
                                        🗑️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Botones de acción -->
            <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
                <button @onclick="AgregarFila"
                        style="background:#6c757d; color:white; padding:10px 18px; border:none; border-radius:8px; cursor:pointer;">
                    ➕ Agregar Fila
                </button>
                <button @onclick="GuardarDatos" disabled="@isGuardando"
                        style="background:#28a745; color:white; padding:10px 24px; border:none; border-radius:8px; font-size:15px; cursor:pointer;">
                    💾 @(isGuardando ? "Guardando..." : "Guardar en DB")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeGuardado))
            {
                <div style="margin-top:12px; padding:12px; background:#e8f5e9; border-radius:8px; color:#2e7d32;">
                    ✅ @mensajeGuardado
                </div>
            }
        </div>
    }

</div>

@code {

    private bool isLoading = false;
    private bool isGuardando = false;
    private string errorMessage = string.Empty;
    private string mensajeGuardado = string.Empty;
    private List<ReportRow> rows = new();

    private string thStyle = "padding:8px 10px; text-align:left; white-space:nowrap;";
    private string tdStyle = "padding:4px 6px;";
    private string inputStyle = "width:90px; padding:4px; border:1px solid #ccc; border-radius:4px; font-size:12px;";
    private string inputStyleNum = "width:60px; padding:4px; border:1px solid #ccc; border-radius:4px; font-size:12px; text-align:right;";

    private async Task OnTakePhotoClicked()
    {
        if (!MediaPicker.Default.IsCaptureSupported)
        {
            errorMessage = "Este dispositivo no soporta cámara.";
            return;
        }
        var photo = await MediaPicker.Default.CapturePhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task OnPickPhotoClicked()
    {
        var photo = await MediaPicker.Default.PickPhotoAsync();
        if (photo == null) return;
        await ProcesarFoto(photo);
    }

    private async Task ProcesarFoto(FileResult photo)
    {
        try
        {
            errorMessage = string.Empty;
            mensajeGuardado = string.Empty;
            rows = new();
            isLoading = true;
            StateHasChanged();

            AppSettingsLoader.Load();
            var endpoint = AppSettings.Current.AzureComputerVision.Endpoint;
            var apiKey = AppSettings.Current.AzureComputerVision.Key;

            if (string.IsNullOrWhiteSpace(endpoint) || string.IsNullOrWhiteSpace(apiKey))
            {
                errorMessage = "No se encontró el Endpoint o Key de Azure en appsettings.json.";
                return;
            }

            using var stream = await photo.OpenReadAsync();
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var azureService = new AzureOcrService(endpoint, apiKey);
            var reportData = await azureService.AnalyzeReportAsync(memoryStream);

            rows = reportData.Rows;

            if (rows.Count == 0)
                errorMessage = "No se detectaron filas. Intenta con mejor iluminación.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EliminarFila(ReportRow row) => rows.Remove(row);

    private void AgregarFila() => rows.Add(new ReportRow());

    private async Task GuardarDatos()
    {
        try
        {
            isGuardando = true;
            mensajeGuardado = string.Empty;
            errorMessage = string.Empty;
            StateHasChanged();

            int guardados = 0;
            int fallidos = 0;

            foreach (var row in rows)
            {
                // Mapear ReportRow → Sew_TempPackingDTO
                var dto = new TempPackingDTO
                {
                    Buyer = row.Buyer ?? string.Empty,
                    Style = row.Style ?? string.Empty,
                    Po = row.PO ?? string.Empty,
                    Color = row.Color ?? string.Empty,
                    Orden = row.Orden ?? string.Empty,
                    Xs = (int)row.XS,
                    S = (int)row.S,
                    M = (int)row.M,
                    L = (int)row.L,
                    Xl = (int)row.XL,
                    Xl2 = (int)row.XL2,
                    Xl3 = (int)row.XL3,
                    TodayTotal = (int)row.TotalHoy
                };

                var ok = await TempPackingService.InsertAsync(dto);
                if (ok) guardados++;
                else fallidos++;
            }

            if (fallidos == 0)
                mensajeGuardado = $"✅ {guardados} fila(s) guardadas correctamente.";
            else
                mensajeGuardado = $"⚠️ {guardados} guardadas, {fallidos} fallidas. Revisa tu conexión.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            isGuardando = false;
            StateHasChanged();
        }
    }
}
