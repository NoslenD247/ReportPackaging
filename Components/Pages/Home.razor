@page "/home"
@using ReportPackaging.Services

<h1>Hello, world!</h1>
<p>Email: @_email</p>
<p>Logged in: @_isLoggedIn</p>

@code {
    private string _email = string.Empty;
    private string _token = string.Empty;
    private bool _isLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        _email = SessionService.GetUserEmail();
        _isLoggedIn = Preferences.Get("is_logged_in", false);
        _token = await SecureStorage.GetAsync("clerk_JWT") ?? "VACÍO";
    }
}