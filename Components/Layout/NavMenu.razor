@using ReportPackaging.Services
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ReportPackaging</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @* <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div> *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="take-photo">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Report Packaging
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shipping-capture">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Shipping Capture
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link" style="background:none; border:none; width:100%; text-align:left; cursor:pointer; color:white;"
                    @onclick="Logout">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Logout
            </button>
        </div>
    </nav>
</div>

@code {
    private void Logout()
    {
        SecureStorage.Remove("clerk_JWT");
        SecureStorage.Remove("login_type");
        SessionService.ClearSession();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
